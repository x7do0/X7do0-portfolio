<article class="project-card @(Project.Featured ? "project-card--featured" : string.Empty)">
    <div class="project-copy">
        <span class="project-index">@((Index + 1).ToString("00"))</span>
        <p class="project-kicker">@(Project.Featured ? Labels.FeaturedLabel : Labels.ProjectLabel)</p>
        <h3>@Project.Title</h3>
        <p>@Project.Summary</p>
        <a class="text-link" href="/projects/@Project.Slug">
            @Project.Cta <span aria-hidden="true">↗</span>
        </a>
    </div>

    <ProjectPreview Project="@Project" Compact="true" />
</article>

@code {
    [Parameter, EditorRequired]
    public ProjectContent Project { get; set; } = new();

    [Parameter, EditorRequired]
    public ProjectsSectionContent Labels { get; set; } = new();

    [Parameter]
    public int Index { get; set; }
}
