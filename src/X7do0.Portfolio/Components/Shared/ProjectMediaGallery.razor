@if (Items.Count > 0)
{
    <div class="project-media-grid">
        @foreach (var item in Items)
        {
            <figure class="project-media-card">
                @if (item.IsVideo)
                {
                    <a class="project-media-link project-media-link--video" href="@item.Url" target="_blank" rel="noopener noreferrer" aria-label="@item.Alt">
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                        {
                            <img src="@item.ThumbnailUrl" alt="@item.Alt" loading="lazy" decoding="async" />
                        }
                        <span class="project-media-play" aria-hidden="true">▶</span>
                    </a>
                }
                else
                {
                    <a class="project-media-link" href="@item.Url" target="_blank" rel="noopener noreferrer">
                        <img src="@item.Url" alt="@item.Alt" loading="lazy" decoding="async" />
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(item.Caption))
                {
                    <figcaption>@item.Caption</figcaption>
                }
            </figure>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectMediaContent> Items { get; set; } = [];
}
