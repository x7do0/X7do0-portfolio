@inject LanguageState LanguageState
@implements IDisposable

<div class="workflow-preview @(Compact ? "workflow-preview--compact" : string.Empty)">
    <div class="window-bar">
        <div class="window-dots"><span></span><span></span><span></span></div>
        <span>Enterprise Workflow</span>
        <span class="window-status">@StatusLabel</span>
    </div>
    <div class="workflow-body">
        <div class="workflow-sidebar" aria-hidden="true"><span class="sidebar-brand">EW</span><span></span><span></span><span></span><span></span></div>
        <div class="workflow-content">
            <div class="workflow-title-row"><div><small>@(LanguageState.IsArabic ? "طلب شراء" : "Purchase request")</small><strong>PR-20260728-0001</strong></div><span class="status-pill">@StatusLabel</span></div>
            <div class="progress-line"><span style="@($"width:{ProgressPercent}%")"></span></div>
            <div class="workflow-steps">
                @for (var index = 0; index < Steps.Count; index++)
                {
                    var stepIndex = index;
                    <button type="button" class="workflow-step @(stepIndex <= _activeStep ? "is-active" : string.Empty)" @onclick="() => SelectStep(stepIndex)">
                        <span>@(stepIndex + 1)</span><strong>@Steps[stepIndex]</strong><small>@StepDescriptions[stepIndex]</small>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Compact { get; set; }
    private readonly CancellationTokenSource _animationCancellation = new();
    private int _activeStep;
    private IReadOnlyList<string> Steps => LanguageState.IsArabic ? ["إنشاء الطلب", "مراجعة المسؤول", "اكتمال الموافقة"] : ["Request created", "Manager review", "Approval completed"];
    private IReadOnlyList<string> StepDescriptions => LanguageState.IsArabic ? ["تم حفظ البيانات", "بانتظار القرار", "سُجّل الإجراء"] : ["Details saved", "Decision pending", "Action audited"];
    private string StatusLabel => LanguageState.IsArabic ? (_activeStep == 0 ? "جديد" : _activeStep == 1 ? "قيد المراجعة" : "مكتمل") : (_activeStep == 0 ? "New" : _activeStep == 1 ? "In review" : "Completed");
    private int ProgressPercent => ((_activeStep + 1) * 100) / Steps.Count;

    protected override void OnInitialized() => LanguageState.Changed += HandleLanguageChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            for (var step = 1; step < Steps.Count; step++)
            {
                await Task.Delay(950, _animationCancellation.Token);
                _activeStep = step;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void SelectStep(int index) => _activeStep = index;
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LanguageState.Changed -= HandleLanguageChanged;
        _animationCancellation.Cancel();
        _animationCancellation.Dispose();
    }
}
