@page "/"
@inject LanguageState LanguageState
@inject PortfolioContentService ContentService
@implements IDisposable

<PageTitle>@(_content is null ? "x7do0" : $"{_content.Brand.Name} | x7do0")</PageTitle>

@if (_content is null)
{
    <div class="loading-shell" aria-busy="true"><span></span><span></span><span></span></div>
}
else
{
    <section class="hero">
        <div class="hero-glow hero-glow--one"></div>
        <div class="hero-glow hero-glow--two"></div>
        <div class="container hero-grid">
            <div class="hero-copy">
                <p class="eyebrow">@_content.Hero.Eyebrow</p>
                <h1>@_content.Hero.Title</h1>
                <p class="hero-description">@_content.Hero.Description</p>
                <div class="hero-actions">
                    <a class="button button--primary" href="#projects">@_content.Hero.PrimaryAction</a>
                    <a class="button button--secondary" href="#contact">@_content.Hero.SecondaryAction</a>
                </div>
                <div class="hero-proof">
                    @foreach (var item in _content.Hero.ProofItems)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
            <WorkflowPreview />
        </div>
    </section>

    <section id="projects" class="section">
        <div class="container">
            <header class="section-heading">
                <p class="eyebrow">@_content.ProjectsSection.Eyebrow</p>
                <h2>@_content.ProjectsSection.Title</h2>
                <p>@_content.ProjectsSection.Description</p>
            </header>

            @for (var index = 0; index < _content.Projects.Count; index++)
            {
                var project = _content.Projects[index];
                <article class="project-card @(project.Featured ? "project-card--featured" : string.Empty)">
                    <div class="project-copy">
                        <span class="project-index">@((index + 1).ToString("00"))</span>
                        <p class="project-kicker">@(project.Featured ? _content.ProjectsSection.FeaturedLabel : _content.ProjectsSection.ProjectLabel)</p>
                        <h3>@project.Title</h3>
                        <p>@project.Summary</p>
                        <a class="text-link" href="/projects/@project.Slug">
                            @project.Cta <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                    @if (project.Featured)
                    {
                        <WorkflowPreview Compact="true" />
                    }
                    else
                    {
                        <div class="academy-window" aria-hidden="true">
                            <div class="academy-window__top"><span></span><span></span><span></span></div>
                            <div class="academy-window__body">
                                <div class="lesson-rail"></div>
                                <div class="lesson-content"><span></span><span></span><span></span></div>
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    </section>

    <section id="skills" class="section section--muted">
        <div class="container">
            <header class="section-heading compact-heading">
                <p class="eyebrow">@_content.SkillsSection.Eyebrow</p>
                <h2>@_content.SkillsSection.Title</h2>
            </header>
            <div class="skills-list">
                @for (var index = 0; index < _content.SkillsSection.Items.Count; index++)
                {
                    <article class="skill-row">
                        <span>@((index + 1).ToString("00"))</span>
                        <h3>@_content.SkillsSection.Items[index]</h3>
                    </article>
                }
            </div>
        </div>
    </section>

    <section id="technologies" class="section">
        <div class="container">
            <header class="section-heading">
                <p class="eyebrow">@_content.TechnologiesSection.Eyebrow</p>
                <h2>@_content.TechnologiesSection.Title</h2>
                <p>@_content.TechnologiesSection.Description</p>
            </header>
            <div class="technology-grid">
                @foreach (var group in _content.TechnologiesSection.Groups)
                {
                    <article class="technology-group">
                        <h3>@group.Title</h3>
                        <div class="technology-tags">
                            @foreach (var item in group.Items)
                            {
                                <span>@item</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section id="education" class="section education-section">
        <div class="container split-card">
            <div>
                <p class="eyebrow">@_content.Education.Eyebrow</p>
                <h2>@_content.Education.Title</h2>
            </div>
            <div>
                <p class="large-copy">@_content.Education.Description</p>
                <small>@_content.Education.Institution</small>
            </div>
        </div>
    </section>

    <section id="knowledge" class="section">
        <div class="container">
            <header class="section-heading">
                <p class="eyebrow">@_content.Knowledge.Eyebrow</p>
                <h2>@_content.Knowledge.Title</h2>
                <p>@_content.Knowledge.Description</p>
            </header>
            <div class="knowledge-card">
                <div class="channel-identity">
                    <div class="channel-avatar">x7</div>
                    <div><strong>x7do0</strong><span>YouTube</span></div>
                </div>
                <div class="video-grid">
                    @for (var index = 0; index < 3; index++)
                    {
                        <div class="video-placeholder">
                            <span class="play-icon">▶</span>
                            <small>@_content.Knowledge.PendingLabel</small>
                        </div>
                    }
                </div>
                @if (string.IsNullOrWhiteSpace(_content.Knowledge.ChannelUrl))
                {
                    <span class="button button--secondary is-disabled" aria-disabled="true">@_content.Knowledge.Action</span>
                }
                else
                {
                    <a class="button button--secondary" href="@_content.Knowledge.ChannelUrl" target="_blank" rel="noopener noreferrer">@_content.Knowledge.Action</a>
                }
            </div>
        </div>
    </section>

    <section id="contact" class="section contact-section">
        <div class="container contact-card">
            <div>
                <p class="eyebrow">@_content.Contact.Eyebrow</p>
                <h2>@_content.Contact.Title</h2>
                <p>@_content.Contact.Description</p>
            </div>
            <div class="contact-actions">
                @foreach (var link in _content.Contact.PrimaryLinks)
                {
                    @if (link.Enabled)
                    {
                        <a class="button @(link.Kind == "primary" ? "button--primary" : "button--secondary")" href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Label</a>
                    }
                    else
                    {
                        <span class="button @(link.Kind == "primary" ? "button--primary" : "button--secondary") is-disabled" aria-disabled="true">@link.Label</span>
                    }
                }
            </div>
            <div class="social-links">
                @foreach (var social in _content.Contact.SocialLinks)
                {
                    @if (social.Enabled)
                    {
                        <a href="@social.Url" target="_blank" rel="noopener noreferrer">@social.Label</a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-disabled="true">@social.Label</span>
                    }
                }
            </div>
        </div>
    </section>
}

@code {
    private PortfolioContent? _content;

    protected override async Task OnInitializedAsync()
    {
        LanguageState.Changed += HandleLanguageChanged;
        await LoadContentAsync();
    }

    private async void HandleLanguageChanged()
    {
        await LoadContentAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadContentAsync() =>
        _content = await ContentService.LoadAsync(LanguageState.Code);

    public void Dispose() => LanguageState.Changed -= HandleLanguageChanged;
}